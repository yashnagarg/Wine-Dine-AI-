# Copy this file to ".env" (same folder) and put your own key there.
# The real .env file is ignored by git. Never commit it, paste it in a report, or show it in a video.
LLM_API_KEY=YOUR_LOCAL_API_KEY_HERE
LLM_MODEL=gpt-4o-mini

# Optional
# DATASET_PATH=data/restaurants.json
# HISTORY_PATH=data/history.json
# Set to true to run without any API key (offline rule-based stand-in for the LLM):
# USE_MOCK_LLM=true
